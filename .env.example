# Copie este arquivo para ".env" (na mesma pasta) e preencha os valores.
# O arquivo .env NÃO deve ir para o Git: ele guarda a sua chave pessoal.

# >>> COLOQUE AQUI A SUA CHAVE DA NASA (https://api.nasa.gov) <<<
NASA_API_KEY=DEMO_KEY


# development | production | testing
ENVIRONMENT=development
DEBUG=false

# Banco de dados (padrão: instance/atlas.db). Exemplo com caminho próprio:
# DATABASE_URL=sqlite+aiosqlite:///./instance/atlas.db
#
# Supabase (PostgreSQL): painel do projeto > Connect > "Transaction pooler" (porta 6543).
# Cole a URL como o Supabase mostra, trocando [YOUR-PASSWORD] pela senha do banco:
# DATABASE_URL=postgresql://postgres.SEU_PROJETO:SUA_SENHA@aws-0-REGIAO.pooler.supabase.com:6543/postgres?sslmode=require

# Por quanto tempo reaproveitar os dados da NASA antes de consultar de novo
ORBITS_TTL_HOURS=24
NEO_TTL_MINUTES=180
APOD_TTL_MINUTES=360

# Quantos asteroides próximos da Terra mostrar (cada um custa 1 requisição)
NEO_LIMIT=10

# Buscar as órbitas no JPL assim que o servidor subir
PREFETCH_ON_STARTUP=true

# Servir a pasta frontend/ em http://127.0.0.1:8000
SERVE_FRONTEND=true
# Origens liberadas no CORS, caso o frontend rode em outro endereço
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
